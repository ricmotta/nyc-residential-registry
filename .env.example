# Copy to .env and change the passwords. .env is ignored by Git.

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
REGISTRY_DB_NAME=registry
REGISTRY_DB_USER=registry
REGISTRY_DB_PASSWORD=change-me-registry
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow

# Object storage (S3 API, SeaweedFS locally)
S3_PORT=8333
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=change-me-access-key
S3_SECRET_KEY=change-me-secret-key
S3_REGION=us-east-1
BRONZE_BUCKET=bronze

# Airflow
AIRFLOW_PORT=8080
AIRFLOW_URL=http://localhost:8080
AIRFLOW_JWT_SECRET=change-me-jwt-secret

# Collectors (used from Phase 1 tickets on)
USER_AGENT=nyc-residential-registry/0.1.0
SOCRATA_APP_TOKEN=
